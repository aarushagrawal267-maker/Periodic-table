# Demo values for the local emulators only (`npm run dev:accounts`, `vite --mode emulators`).
# demo-* project ids need no real Firebase project and reach nothing outside this machine. Not secrets.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-periodica.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-periodica
VITE_FIREBASE_APP_ID=demo-app
VITE_FIREBASE_EMULATORS=1
