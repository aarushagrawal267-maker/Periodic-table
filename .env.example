# Firebase web config for accounts (docs/ACCOUNTS.md section 10).
# Copy to .env.local (ignored by git) and fill in the values from the Firebase console.
# The web config is public by design: it ships in the bundle, and access is enforced by firestore.rules.
# Leave VITE_FIREBASE_PROJECT_ID empty and accounts are off: the app makes no network calls.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: reCAPTCHA Enterprise site key for App Check (docs/ACCOUNTS.md section 10). Public, like the rest.
VITE_FIREBASE_APPCHECK_SITE_KEY=
# 1 = connect to local emulators (auth 9099, firestore 8080). Only for dev servers and demo-* projects:
# a build of a real project with this set fails (vite.config.ts).
VITE_FIREBASE_EMULATORS=
